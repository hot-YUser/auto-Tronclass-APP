# .NET
[Bb]in/
!/core/src/bin/
!/core/src/bin/*.rs
[Oo]bj/
/ui/AppPackages/

# Build artifacts — shipped via GitHub Release, never committed
/dist/
*.apk
*.aab
*.msix
*.msixbundle

# ui/Interop/NativeMethods.g.cs is generated by build.rs but committed on purpose:
# the MAUI project compiles on MockCore without a core build first.

# Secrets / signing material — NEVER commit
*.pfx
*.snk
*.p12
*.pvk
*.cer
*.key
*.keystore
*.jks
keystore.properties

# Local runtime state / logs
/state/
*.log

# Local backup of this project's Claude memory (research notes + test-account refs) — never commit.
Claude Memory/

# Claude Code working directory (session notes, release-note drafts) — never commit.
.claude/

# Local AI handover / review notes (untracked process artifacts)
/AI交接紀錄-*.md

# Default build marker written by tools/build-core.ps1 when run standalone
/core/.native-build-*.json

# Narrow staging/backup residue from tools/check-crlf.ps1 -Fix and tools/update-bindings.ps1
# (same-dir atomic staging; never compiled, tool reports leftovers if AV lock prevents cleanup)
ui/Interop/.NativeMethods.g.cs.tmp-*
ui/Interop/.crlf-fix-*.tmp
ui/Interop/NativeMethods.g.cs.bak-*
/tools/bindings-generator/target/

# IDE / OS
.vs/
.idea/
*.user
*.suo
.DS_Store
Thumbs.db
